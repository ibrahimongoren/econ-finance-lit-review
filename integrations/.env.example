# Copy to .env in the folder where you run the scripts (or pass --env-file). Never commit the real file.
# Every key is optional: without keys the scripts use the free, keyless routes.

# Contact address: sent to Crossref (polite pool) and required by Unpaywall
CONTACT_EMAIL=you@university.edu
UNPAYWALL_EMAIL=

# OpenAlex - free key from https://openalex.org/settings/api (raises the daily budget; search is metered)
OPENALEX_API_KEY=

# Semantic Scholar - free key from https://www.semanticscholar.org/product/api (higher rate limit)
S2_API_KEY=

# Elsevier (Scopus Search API, ScienceDirect Search API) - key from https://dev.elsevier.com
# Works only with an institutional subscription to these APIs, from the campus network / VPN,
# or with an institutional token issued by Elsevier.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# Clarivate Web of Science Starter API - key from https://developer.clarivate.com (free trial plan exists)
WOS_API_KEY=
WOS_DB=WOS

# Google Scholar through SerpApi (paid service; Google Scholar has no official API)
SERPAPI_API_KEY=

# Used by paper-search-mcp (see mcp.json.example)
CORE_API_KEY=
